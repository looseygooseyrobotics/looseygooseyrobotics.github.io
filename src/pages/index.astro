---
import BaseLayout from "../layouts/BaseLayout.astro";
import { siteConfig } from "../config/site";

const promoVideoEmbedUrl = siteConfig.promoVideoUrl.replace("watch?v=", "embed/");
const imageBaseUrl = import.meta.env.BASE_URL;
---

<BaseLayout title={`${siteConfig.name}`}>
  <section class="hero-section">
    <div class="container hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Robotics, but with antics and shenanigans</p>
        <h1 class="hero-headline">
          <span>Build it.</span>
          <span>Rebuild it.</span>
          <span>Somehow we made it worse.</span>
        </h1>
        <p class="hero-text">
          Loosey Goosey Robotics makes it easy to get a team together, build a robot,
          and play a game. A very stupid game that involves inebriation, poor reffing, and bribery.
        </p>
        <div class="hero-actions">
          <a class="button" href="/get-started/">Start your team</a>
          <a class="button button-secondary" href={siteConfig.competitionRulesUrl} target="_blank" rel="noreferrer">Read the rules</a>
        </div>
        <p class="hero-footnote">The 2025–2026 game: <strong>Hexy Hustle</strong></p>
      </div>

      <div class="hero-panel">
        <div class="video-frame">
          <iframe
            src={promoVideoEmbedUrl}
            title="Hexy Hustle reveal video"
            loading="lazy"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            referrerpolicy="strict-origin-when-cross-origin"
            allowfullscreen
          ></iframe>
        </div>
      </div>
    </div>
  </section>

  <section class="home-section competition-section" aria-labelledby="competition-heading">
    <div class="container">
      <div class="section-intro">
        <p class="section-label">How it works</p>
        <h2 id="competition-heading">A competition built for the joy of the build.</h2>
        <p>
          Hexy Hustle is a fast, friendly robotics competition where your team gets to
          design, drive, adapt, and celebrate every match.
        </p>
      </div>
      <div class="competition-facts">
        <article class="fact-card fact-card-teal">
          <span class="fact-number">2</span>
          <h3>Robots per alliance</h3>
          <p>Pair up with another team and plan your strategy.</p>
        </article>
        <article class="fact-card fact-card-orange">
          <span class="fact-number">2:00</span>
          <h3>Driver-controlled match</h3>
          <p>Outscore your opponents with skillful driving.</p>
        </article>
        <article class="fact-card fact-card-navy">
          <span class="fact-number">12″x12″x12″</span>
          <h3>Robot starting volume</h3>
          <p>Just enough space to get creative without breaking the bank.</p>
        </article>
      </div>
      <div class="competition-detail-grid">
        <div>
          <h3>Score the field. Reach the tower. Hang on.</h3>
          <p>
            Score hexes in alliance zones, place them on towers for extra value, and
            hang your robot for bonus points. It is simple to understand, satisfying to
            master, and designed to reward good teamwork.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="home-section roadmap-section" aria-labelledby="roadmap-heading">
    <div class="container">
      <div class="section-intro section-intro-centered">
        <p class="section-label">Get rolling</p>
        <h2 id="roadmap-heading">From “we should do this” to match day.</h2>
        <p>Everything you need to take your next step is right here.</p>
      </div>
      <div class="roadmap-grid">
        <article class="roadmap-card">
          <span class="step-number">01</span>
          <h3>Start a team</h3>
          <p>Gather your people or go at it alone, learn the game, and join a community ready to help you learn the ropes.</p>
          <div class="card-links">
            <a href={siteConfig.competitionRulesUrl} target="_blank" rel="noreferrer">Game rules</a>
            <a href={siteConfig.competitionDiscordUrl} target="_blank" rel="noreferrer">Join Discord</a>
          </div>
        </article>
        <article class="roadmap-card">
          <span class="step-number">02</span>
          <h3>Build a robot</h3>
          <p>Buy parts, design your bot, and build your prototype.</p>
          <div class="card-links">
            <a href="/get-started/#video-walkthroughs">Watch walkthroughs</a>
          </div>
        </article>
        <article class="roadmap-card">
          <span class="step-number">03</span>
          <h3>Attend an event</h3>
          <p>Test your robot, check the schedule, and bring your team to compete.</p>
          <div class="card-links">
            <a href="/competitions/">View competitions</a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="home-section about-section" aria-labelledby="about-heading">
    <div class="container about-grid">
      <div class="about-photos">
        <img
          class="about-photo about-photo-couple"
          src={`${imageBaseUrl}styles/images/couple.jpg`}
          alt=""
        />
      </div>
      <div class="about-copy">
        <p class="section-label">About us</p>
        <h2 id="about-heading">Doing it for the love of the game!</h2>
        <p>
          <strong>Founder Micah Rassi</strong>, has spent over 10 years in competitive educational robotics. A Purdue University graduate in Robotics Engineering Technology and former president of World Champion VEX U team Purdue SIGBots.
        </p>
        <p>
          After competing from high school through college, mentoring teams, and trying everything from battlebots to esports, Micah kept coming back to the same thing: building robots with friends. Loosey Goosey Robotics exists to make that feeling accessible to seasoned robotics veterans and beginners alike.
        </p>
        <a class="button button-dark" href={siteConfig.founderLinkedInUrl} target="_blank" rel="noreferrer">Connect with Micah on LinkedIn</a>
      </div>
    </div>
  </section>
</BaseLayout>
