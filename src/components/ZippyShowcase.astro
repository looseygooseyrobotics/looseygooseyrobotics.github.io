---
const releasesUrl = "https://github.com/Marsgate/zippy-manager/releases/latest";
const repoUrl = "https://github.com/Marsgate/zippy-manager";
const img = (name: string) => `/styles/images/zippy/${name}.webp`;

// Each feature swaps the big screen, and some bring in the ref's tablet.
const features = [
  {
    title: "Make a schedule",
    blurb:
      "If you are lucky, it might work on the first try!",
    device: "Laptop",
    screen: img("app-schedule"),
    alt: "Zippy Manager schedule and rankings page",
    theme: "light"
  },
  {
    title: "Check teams in",
    blurb:
      "Is everyone here? No? Well at least the app looks cool.",
    device: "Laptop",
    screen: img("app-checkin"),
    alt: "Team check-in screen with red and blue alliance cards",
    theme: "light"
  },
  {
    title: "Run matches",
    blurb:
      "Audience display (ooooh, aaaaaah)",
    device: "TV",
    screen: img("tv-timer"),
    alt: "Audience display showing a match timer at 1:14",
    tablet: img("ref-timer"),
    tabletAlt: "Ref tablet with the match timer and pause button",
    theme: "dark"
  },
  {
    title: "Score on a tablet",
    blurb:
      "Score matches from a phone, tablet, or Samsung fridge.",
    device: "TV",
    screen: img("tv-final"),
    alt: "Audience display showing the final score, 15 to 10",
    tablet: img("ref-scoring"),
    tabletAlt: "Ref tablet scoring screen with a map of the field",
    theme: "dark"
  },
  {
    title: "Provide supplemental info",
    blurb:
      "Show who's on deck. They will still be late.",
    device: "TV",
    screen: img("tv-rankings"),
    alt: "Audience display showing qualification rankings",
    theme: "dark"
  },
  {
    title: "Select alliance partners",
    blurb:
      "Watch that one team backstab you in real-time.",
    device: "TV",
    screen: img("tv-alliance"),
    alt: "Audience display showing alliance selection in progress",
    theme: "dark"
  },
  {
    title: "Generate a bracket",
    blurb:
      "Why are you even reading this far? Nobody is gonna pick you anyway.",
    device: "TV",
    screen: img("tv-bracket"),
    alt: "Audience display showing the elimination bracket",
    theme: "dark"
  }
];

const stats: { value: number; prefix?: string; postfix?: string; label: string }[] = [
  { value: 99, prefix: "Free", label: "Open source" },
  { value: 3, prefix: "", label: "Operating systems. Mac, Windows, and Linux" },
  { value: 50, postfix: "%", label: "Chance of it working as intended" }
];
---

<section class="zippy-section ground-dark" id="zippy-manager" aria-labelledby="zippy-heading">
  <div class="zippy-hexes" aria-hidden="true">
    {Array.from({ length: 4 }, (_, i) => (
      <svg class={`zippy-hex zippy-hex-${i + 1}`} viewBox="0 0 100 88">
        <polygon points="25,2 75,2 98,44 75,86 25,86 2,44" />
        <polygon points="38,26 62,26 74,44 62,62 38,62 26,44" />
      </svg>
    ))}
  </div>

  <div class="container zippy-inner">
    <div class="zippy-top">
      <div class="zippy-intro">
        <h2 id="zippy-heading">Zippy Manager</h2>
        <p>
          Running a good event starts with bad software.
        </p>
      </div>
      <div class="zippy-cta">
        <a class="button zippy-download" href={releasesUrl} target="_blank" rel="noreferrer">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v12m0 0-5-5m5 5 5-5M4 20h16" /></svg>
          Download Zippy Manager
        </a>
        <p>
          Mac, Windows, and Linux ·{" "}
          <a href={repoUrl} target="_blank" rel="noreferrer">Source on GitHub</a>
        </p>
      </div>
    </div>

    <div class="zippy-demo" data-zippy-demo>
      <ol class="zippy-features" role="list" aria-label="Zippy Manager features">
        {features.map((feature, i) => (
          <li>
            <button
              type="button"
              class:list={["zippy-feature", { "is-active": i === 0 }]}
              data-index={i}
              aria-pressed={i === 0 ? "true" : "false"}
            >
              <span class="zippy-feature-num">{String(i + 1).padStart(2, "0")}</span>
              <span class="zippy-feature-body">
                <span class="zippy-feature-title">{feature.title}</span>
                <span class="zippy-feature-blurb"><span>{feature.blurb}</span></span>
              </span>
            </button>
          </li>
        ))}
      </ol>

      <div class="zippy-stage">
        <div class="zippy-screen" data-theme={features[0].theme}>
          <div class="zippy-screen-bar" aria-hidden="true">
            <span></span><span></span><span></span>
            <em class="zippy-device-label">{features[0].device}</em>
          </div>
          <div class="zippy-screen-view">
            {features.map((feature, i) => (
              <img
                class:list={["zippy-shot", { "is-active": i === 0 }]}
                src={feature.screen}
                alt={feature.alt}
                width="1600"
                height={feature.theme === "light" ? 1021 : 900}
                loading={i === 0 ? "eager" : "lazy"}
                decoding="async"
                data-index={i}
                data-theme={feature.theme}
                data-device={feature.device}
              />
            ))}
          </div>
        </div>
        <div class="zippy-stand" aria-hidden="true"></div>

        <div class="zippy-tablet" aria-hidden="true">
          {features.map((feature, i) =>
            feature.tablet ? (
              <img
                class="zippy-tablet-shot"
                src={feature.tablet}
                alt={feature.tabletAlt}
                width="700"
                height="1007"
                loading="lazy"
                decoding="async"
                data-index={i}
              />
            ) : null
          )}
        </div>
      </div>
    </div>

    <dl class="zippy-stats">
      {stats.map((stat) => (
        <div class="zippy-stat">
          <dt>{stat.prefix}{stat.value}{stat.postfix}</dt>
          <dd>{stat.label}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<script>
  // The feature list only changes the screen when someone picks a feature.
  const demo = document.querySelector<HTMLElement>("[data-zippy-demo]");

  if (demo) {
    const buttons = [...demo.querySelectorAll<HTMLButtonElement>(".zippy-feature")];
    const shots = [...demo.querySelectorAll<HTMLImageElement>(".zippy-shot")];
    const tablet = demo.querySelector<HTMLElement>(".zippy-tablet")!;
    const tabletShots = [...demo.querySelectorAll<HTMLImageElement>(".zippy-tablet-shot")];
    const screen = demo.querySelector<HTMLElement>(".zippy-screen")!;
    const label = demo.querySelector<HTMLElement>(".zippy-device-label")!;

    const show = (index: number) => {
      buttons.forEach((button, i) => {
        const on = i === index;
        button.classList.toggle("is-active", on);
        button.setAttribute("aria-pressed", String(on));
      });
      shots.forEach((shot, i) => shot.classList.toggle("is-active", i === index));
      const tabletShot = tabletShots.find((shot) => Number(shot.dataset.index) === index);
      tabletShots.forEach((shot) => shot.classList.toggle("is-active", shot === tabletShot));
      tablet.classList.toggle("is-visible", Boolean(tabletShot));
      screen.dataset.theme = shots[index].dataset.theme;
      label.textContent = tabletShot ? "TV + ref tablet" : shots[index].dataset.device ?? "";
    };

    buttons.forEach((button, i) => button.addEventListener("click", () => show(i)));
  }
</script>

<style>
  .zippy-section {
    position: relative;
    padding: clamp(4.5rem, 9vw, 7.5rem) 0;
    background: var(--navy-deep);
    color: var(--on-navy);
    overflow: hidden;
    isolation: isolate;
  }

  .zippy-inner {
    position: relative;
    width: min(1240px, calc(100% - 2rem));
  }

  /* Static hex outlines in the background. */
  .zippy-hexes {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
  }

  .zippy-hex {
    position: absolute;
    width: 7rem;
    fill: none;
    stroke-width: 2.5;
    opacity: 0.35;
  }

  .zippy-hex:nth-child(odd) {
    stroke: var(--teal);
  }

  .zippy-hex:nth-child(even) {
    stroke: var(--orange);
  }

  .zippy-hex-1 { top: 6%; left: 4%; width: 5rem; transform: rotate(12deg); }
  .zippy-hex-2 { top: 14%; right: 8%; width: 8rem; transform: rotate(-18deg); }
  .zippy-hex-3 { top: 48%; left: -2%; width: 9rem; transform: rotate(30deg); }
  .zippy-hex-4 { bottom: 10%; right: 3%; width: 6rem; transform: rotate(-8deg); }

  /* Intro */
  .zippy-top {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    gap: 2rem 3rem;
    align-items: end;
  }

  .zippy-intro h2 {
    margin: 0 0 1rem;
    font-family: var(--font-display);
    font-size: clamp(2rem, 4.2vw, 3.5rem);
    font-weight: 700;
    line-height: 1.04;
    letter-spacing: var(--tracking-display);
  }

  .zippy-intro p:last-child {
    max-width: 60ch;
    margin: 0;
    color: var(--on-navy-deep-soft);
    font-size: 1.08rem;
    line-height: 1.65;
  }

  .zippy-cta {
    justify-self: end;
    text-align: right;
  }

  .zippy-cta p {
    margin: 0.85rem 0 0;
    color: var(--on-navy-deep-muted);
    font-size: 0.92rem;
  }

  .zippy-cta p a {
    color: var(--on-navy);
    font-weight: 700;
  }

  .zippy-download {
    gap: 0.6rem;
    padding-inline: 1.4rem;
  }

  .zippy-download svg {
    width: 1.2rem;
    height: 1.2rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* Demo: feature buttons + stage */
  .zippy-demo {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.65fr);
    gap: clamp(1.5rem, 3vw, 3rem);
    align-items: center;
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }

  .zippy-features {
    display: grid;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Each row is a toggle button. Unselected rows still read as buttons
     (outline + chevron); the selected one gets a fill, an orange edge bar
     and its blurb, so the state isn't carried by color alone. */
  .zippy-feature {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 0.9rem;
    width: 100%;
    min-height: 44px;
    padding: 0.8rem 1rem;
    border: 1px solid var(--glass-rule);
    border-radius: var(--radius-lg);
    background: transparent;
    color: var(--on-navy-deep-muted);
    font: inherit;
    text-align: left;
    cursor: pointer;
    overflow: hidden;
    transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }

  .zippy-feature::after {
    content: "";
    align-self: start;
    width: 0.5rem;
    height: 0.5rem;
    margin-top: 0.45rem;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: rotate(-45deg);
  }

  .zippy-feature.is-active::after {
    transform: rotate(45deg);
  }

  .zippy-feature::before {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 4px;
    background: var(--orange);
    opacity: 0;
  }

  .zippy-feature:hover {
    color: var(--on-navy);
    background: var(--glass-fill);
    border-color: var(--on-navy-deep-muted);
  }

  .zippy-feature:focus-visible {
    color: var(--on-navy);
    outline: 2px solid var(--teal);
    outline-offset: 2px;
  }

  .zippy-feature.is-active {
    color: var(--on-navy);
    background: var(--glass-fill-active);
    border-color: var(--on-navy-deep-muted);
    cursor: default;
  }

  .zippy-feature.is-active::before {
    opacity: 1;
  }

  .zippy-feature-num {
    padding-top: 0.15rem;
    color: var(--orange);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.08em;
  }

  .zippy-feature-title {
    display: block;
    font-size: 1.08rem;
    font-weight: var(--weight-bold);
  }

  /* Blurbs expand under the selected feature. */
  .zippy-feature-blurb {
    display: grid;
    grid-template-rows: 0fr;
    color: var(--on-navy-deep-soft);
    font-size: 0.95rem;
    line-height: 1.55;
    overflow: hidden;
    opacity: 0;
    transition: grid-template-rows 0.3s ease, opacity 0.3s ease, margin 0.3s ease;
  }

  .zippy-feature-blurb > span {
    min-height: 0;
  }

  .zippy-feature.is-active .zippy-feature-blurb {
    grid-template-rows: 1fr;
    margin-top: 0.4rem;
    opacity: 1;
  }

  /* The stage: a screen with a bezel, plus a tablet for the ref features. */
  .zippy-stage {
    position: relative;
    padding-bottom: 2.4rem;
    perspective: 1600px;
  }

  .zippy-screen {
    position: relative;
    z-index: 1;
    padding: 0 0.65rem 0.65rem;
    border-radius: 1.1rem;
    background: var(--device-bezel);
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.08),
      0 40px 80px -20px rgba(0, 0, 0, 0.65),
      0 0 120px -30px rgba(0, 169, 165, 0.55);
    transform: rotateY(-7deg) rotateX(3deg);
    transform-origin: 60% 50%;
    transition: box-shadow 0.4s ease;
  }

  .zippy-screen[data-theme="light"] {
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.08),
      0 40px 80px -20px rgba(0, 0, 0, 0.65),
      0 0 120px -30px rgba(255, 112, 67, 0.55);
  }

  .zippy-screen-bar {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    height: 2rem;
    padding-inline: 0.35rem;
  }

  .zippy-screen-bar span {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    background: #ff5f57;
  }

  .zippy-screen-bar span:nth-child(2) { background: #febc2e; }
  .zippy-screen-bar span:nth-child(3) { background: #28c840; }

  .zippy-device-label {
    margin-left: auto;
    padding: 0.15rem 0.6rem;
    border-radius: var(--radius-pill);
    background: var(--glass-rule);
    color: var(--on-navy-deep-soft);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-style: normal;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  /* The screen's ground doubles as the loading placeholder, sized by the
     aspect ratio so nothing shifts when the screenshot arrives. */
  .zippy-screen-view {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: 0.45rem;
    background: var(--navy);
    transition: background 0.3s ease;
  }

  .zippy-screen[data-theme="light"] .zippy-screen-view {
    background: var(--bg);
  }

  .zippy-shot {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .zippy-shot.is-active {
    opacity: 1;
  }

  .zippy-stand {
    width: 22%;
    height: 1.4rem;
    margin: -0.2rem auto 0;
    border-radius: 0 0 0.6rem 0.6rem;
    background: var(--device-bezel);
    transform: rotateY(-7deg);
  }

  .zippy-tablet {
    position: absolute;
    z-index: 2;
    right: -1.5rem;
    bottom: -0.5rem;
    width: 29%;
    aspect-ratio: 700 / 1007;
    padding: 0.45rem;
    border-radius: 1.2rem;
    background: var(--device-tablet);
    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.1), 0 30px 60px -10px rgba(0, 0, 0, 0.7);
    opacity: 0;
    transform: translate(1rem, 1.5rem) rotate(6deg);
    transition: opacity 0.3s ease, transform 0.4s ease;
    pointer-events: none;
  }

  .zippy-tablet.is-visible {
    opacity: 1;
    transform: rotate(4deg);
  }

  .zippy-tablet-shot {
    position: absolute;
    inset: 0.45rem;
    width: calc(100% - 0.9rem);
    height: calc(100% - 0.9rem);
    border-radius: 0.8rem;
    background: var(--navy);
    object-fit: cover;
    object-position: top;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .zippy-tablet-shot.is-active {
    opacity: 1;
  }

  /* Stats */
  .zippy-stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    margin: clamp(3rem, 6vw, 4.5rem) 0 0;
  }

  .zippy-stat {
    padding: 1.3rem 1.4rem;
    border: 1px solid var(--glass-rule);
    border-radius: var(--radius-xl);
    background: var(--glass-fill);
  }

  .zippy-stat dt {
    color: var(--teal-light);
    font-family: var(--font-mono);
    font-size: clamp(2.4rem, 4vw, 3.2rem);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    line-height: 1;
    letter-spacing: normal;
  }

  .zippy-stat dd {
    margin: 0.6rem 0 0;
    color: var(--on-navy-deep-soft);
    line-height: 1.5;
  }

  @media (max-width: 1000px) {
    .zippy-demo {
      grid-template-columns: 1fr;
    }

    .zippy-stage {
      order: -1;
      margin-inline: 0.5rem;
    }

    .zippy-screen,
    .zippy-stand {
      transform: none;
    }

    .zippy-tablet {
      right: -0.5rem;
    }
  }

  @media (max-width: 900px) {
    .zippy-top {
      grid-template-columns: 1fr;
    }

    .zippy-cta {
      justify-self: start;
      text-align: left;
    }

    .zippy-stats {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .zippy-hex {
      opacity: 0.15;
    }

    .zippy-cta {
      justify-self: stretch;
    }

    .zippy-download {
      width: 100%;
    }

    .zippy-stage {
      margin-inline: 0;
    }

    .zippy-screen {
      padding: 0 0.35rem 0.35rem;
      border-radius: 0.7rem;
    }

    .zippy-screen-bar {
      height: 1.5rem;
    }

    .zippy-screen-bar span {
      width: 0.45rem;
      height: 0.45rem;
    }

    .zippy-tablet {
      right: 0;
      width: 32%;
      padding: 0.25rem;
      border-radius: 0.7rem;
    }

    .zippy-tablet-shot {
      inset: 0.25rem;
      width: calc(100% - 0.5rem);
      height: calc(100% - 0.5rem);
      border-radius: 0.5rem;
    }

    .zippy-feature {
      padding: 0.75rem 0.85rem;
      gap: 0.7rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .zippy-feature,
    .zippy-feature-blurb,
    .zippy-screen,
    .zippy-screen-view,
    .zippy-shot,
    .zippy-tablet,
    .zippy-tablet-shot {
      transition: none;
    }
  }
</style>
